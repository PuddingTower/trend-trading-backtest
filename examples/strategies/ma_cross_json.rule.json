{
  "schemaVersion": 1,
  "kind": "rules",
  "id": "ma_cross_json",
  "name": "JSON 双均线示例",
  "description": "收盘站上 20 日均线做多，跌破 60 日均线平仓；仅用于演示规则导入。",
  "revision": 1,
  "parameters": {
    "fast": {
      "type": "integer",
      "default": 20,
      "min": 2,
      "max": 200,
      "label": "快线周期",
      "description": "短期均线回看根数"
    },
    "slow": {
      "type": "integer",
      "default": 60,
      "min": 3,
      "max": 500,
      "label": "慢线周期",
      "description": "长期均线回看根数"
    }
  },
  "requires": {
    "fields": ["open", "high", "low", "close", "volume"]
  },
  "series": {
    "fastMa": {
      "op": "sma",
      "source": { "field": "close" },
      "period": { "param": "fast" }
    },
    "slowMa": {
      "op": "sma",
      "source": { "field": "close" },
      "period": { "param": "slow" }
    }
  },
  "rules": [
    {
      "when": {
        "op": "and",
        "conditions": [
          { "op": "greaterThan", "left": { "field": "close" }, "right": { "series": "fastMa" } },
          { "op": "greaterThan", "left": { "series": "fastMa" }, "right": { "series": "slowMa" } }
        ]
      },
      "do": {
        "action": "long",
        "reason": "价格与快线均站上慢线"
      }
    },
    {
      "when": {
        "op": "and",
        "conditions": [
          { "op": "lessThan", "left": { "field": "close" }, "right": { "series": "fastMa" } },
          { "op": "lessThan", "left": { "series": "fastMa" }, "right": { "series": "slowMa" } }
        ]
      },
      "do": {
        "action": "close",
        "reason": "价格与快线均跌破慢线"
      }
    }
  ]
}
